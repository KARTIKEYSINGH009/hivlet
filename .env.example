# Supabase — fill these in from your Supabase project dashboard
# (Project Settings → API). No real secrets are committed; these stay empty here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Auth note: in Supabase → Authentication → Providers → Email, you can turn
# OFF "Confirm email" for local dev (instant sign-in). With it ON, sign-up
# shows a "check your email" notice and the /auth/callback route completes it.

# Execution engine (Milestone 3) — SERVER-ONLY vars. Never prefix these
# with NEXT_PUBLIC_ (that would ship them to the browser), and never
# commit filled-in values. Keys are resolved from here at run time; the
# database stores only references (agent_credentials.key_reference).
# SUPABASE_URL= (defaults to NEXT_PUBLIC_SUPABASE_URL when unset)
# SUPABASE_SERVICE_ROLE_KEY= (worker only; never expose to the browser)
# WORKER_SECRET= (shared secret guarding POST /api/executions/run)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY= (or GOOGLE_GENERATIVE_AI_API_KEY)
# APP_URL=http://localhost:3000 (standalone scripts/worker.ts loop only)
# WORKER_INTERVAL_MS=30000
# WORKER_BATCH_LIMIT=5
